{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",
    "lib": ["ES2021"],
    "outDir": "dist-test",
    "rootDir": "src",
    "sourceMap": false,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node"
  },
  "include": ["src/parser/**/*.ts", "src/graph/**/*.ts", "src/**/*.test.ts"],
  "exclude": ["node_modules", "dist", "src/extension.ts", "src/webview/**"]
}
